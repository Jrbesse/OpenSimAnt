{
  "assets": [
    {
      "Name": "soundbank",
      "bytes": 2856,
      "About": "the sound driver\u0027s bank (SoundBank): per MIDI channel a priority and an instrument (DS:0068), the FM records (16 bytes, DS:0202..) and sample records (0x20 bytes, DS:0342..), the 56 effects (key, priority, instrument, velocity; DS:0A82), the 56 instruments (device, record; DS:0D92)"
    },
    {
      "Name": "balloon",
      "bytes": 176,
      "About": "the speech balloon\u0027s 8 x 8 pieces, 16 bytes each: corners, edges, inside, two tails (Balloon)"
    },
    {
      "Name": "spiderlegs",
      "bytes": 304,
      "About": "the spider\u0027s leg and fang coordinates per heading and frame (SpiderLegs reads them from the State\u0027s T:09E4)"
    },
    {
      "Name": "glossary",
      "bytes": 886,
      "About": "the SimAntipedia glossary: 0x22-byte entries (u16 text id, a 32-byte upper-case word), ending with id 0"
    }
  ],
