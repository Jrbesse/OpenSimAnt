; Engine configuration file.

config_version=5

[application]

config/name="OpenSimAnt"
config/description="A fan remake of a 1991 ant-colony simulator, built on a byte-exact port of its simulation. Requires your own copy of the original game's files."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "C#")

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="OpenSimAnt"
project/solution_directory="../"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
